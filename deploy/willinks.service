[Unit]
Description=Willinks URL Shortener
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/willinks
ExecStart=/usr/bin/dotnet /opt/willinks/Willinks.Api.dll
Restart=always
RestartSec=5
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://localhost:5000
EnvironmentFile=/opt/willinks/.env

[Install]
WantedBy=multi-user.target
