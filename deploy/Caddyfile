# Admin dashboard subdomain
links.willc.pro {
    reverse_proxy localhost:5000
}

# Main domain (public redirects)
willc.pro {
    # Serve the primary site deployed by the willc-personalsite repo.
    root * /var/www/jekyll

    # Let the static site win for direct assets, directories, and clean URLs
    # like /blog/my-post by checking for an index file before falling back.
    @static file {
        try_files {path} {path}/ {path}/index.html
    }

    handle @static {
        file_server
    }

    # Everything else goes to Willinks for shortlink redirects.
    handle {
        reverse_proxy localhost:5000
    }
}
