# Admin dashboard subdomain
links.willc.pro {
    reverse_proxy localhost:5000
}

# Main domain (public redirects)
willc.pro {
    # Serve Jekyll static files if they exist on disk
    root * /var/www/jekyll

    @static file
    handle @static {
        file_server
    }

    # Everything else goes to Willinks (.NET app)
    handle {
        reverse_proxy localhost:5000
    }
}
